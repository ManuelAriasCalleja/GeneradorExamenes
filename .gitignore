# Compilación (también las de otras carpetas, como build-sanitizadores) y cachés del editor
build/
build-*/
.cache/

# Preguntas: el repositorio se publica y no puede contener ninguna pregunta de ningún banco. Los bancos están
# en el directorio de cada asignatura; «datos», «banco2» y «BancoPreguntas» son enlaces locales a ellos (ver
# CLAUDE.md). Sin barra al final, para que valgan también para los enlaces.
/datos
/banco2
/BancoPreguntas
/asignatura
*.db
*.docx
preguntas*.json
*.xml

# Exámenes exportados, por si se guardan dentro del proyecto
*.pdf
*.html
!/recursos/ayuda.html
!/recursos/ayuda_en.html
*.tex
*_imagenes/
*-imagenes/

# Presentación del programa para el equipo docente: se queda fuera de git
/presentacion/
